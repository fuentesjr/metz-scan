  {
    "id": 4,
    "repo": "fuentesjr/metz-scan",
    "kind": "static",
    "expect": "static check fails",
    "rules": [
      {
        "name": "second trigger",
        "file": "workflow",
        "from": "    types: [opened, synchronize, reopened, labeled, unlabeled]\n",
        "to": "    types: [opened, synchronize, reopened, labeled, unlabeled]\n  push:\n"
      },
      {
        "name": "extra permission",
        "file": "workflow",
        "from": "  pull-requests: read\n",
        "to": "  pull-requests: read\n  checks: write\n"
      },
      {
        "name": "drop contents read",
        "file": "workflow",
        "from": "  contents: read\n",
        "to": ""
      },
      {
        "name": "checkout head sha",
        "file": "workflow",
        "from": "github.event.pull_request.base.sha",
        "to": "github.event.pull_request.head.sha"
      },
      {
        "name": "persist credentials",
        "file": "workflow",
        "from": "persist-credentials: false",
        "to": "persist-credentials: true"
      },
      {
        "name": "job name",
        "file": "workflow",
        "from": "jobs:\n  fasttrack-allowlist:\n",
        "to": "jobs:\n  other-job:\n"
      },
      {
        "name": "token expression",
        "file": "workflow",
        "from": "${{ github.token }}",
        "to": "${{ secrets.GITHUB_TOKEN }}"
      },
      {
        "name": "drop labeled",
        "file": "workflow",
        "from": "opened, synchronize, reopened, labeled, unlabeled",
        "to": "opened, synchronize, reopened, unlabeled"
      },
      {
        "name": "drop unlabeled",
        "file": "workflow",
        "from": "opened, synchronize, reopened, labeled, unlabeled",
        "to": "opened, synchronize, reopened, labeled"
      },
      {
        "name": "reorder types",
        "file": "workflow",
        "from": "labeled, unlabeled",
        "to": "unlabeled, labeled"
      },
      {
        "name": "pull request target",
        "file": "workflow",
        "from": "  pull_request:\n",
        "to": "  pull_request_target:\n"
      },
      {
        "name": "workflow run trigger",
        "file": "workflow",
        "from": "  pull_request:\n",
        "to": "  pull_request:\n  workflow_run:\n"
      },
      {
        "name": "job permissions",
        "file": "workflow",
        "from": "  fasttrack-allowlist:\n    runs-on:",
        "to": "  fasttrack-allowlist:\n    permissions:\n      contents: write\n    runs-on:"
      },
      {
        "name": "drop token env",
        "file": "workflow",
        "from": "        env:\n          GITHUB_TOKEN: ${{ github.token }}\n",
        "to": ""
      },
      {
        "name": "pins key",
        "file": "allowlist",
        "from": "repo: fuentesjr/metz-scan\n",
        "to": "repo: fuentesjr/metz-scan\npins: []\n"
      },
      {
        "name": "lockfiles key",
        "file": "allowlist",
        "from": "repo: fuentesjr/metz-scan\n",
        "to": "repo: fuentesjr/metz-scan\nlockfiles: []\n"
      }
    ]
  },
