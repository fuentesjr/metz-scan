              "help": {
                "text": "Service-object soup scatters one workflow across many procedural steps and makes orchestration harder to change."
              },
              "fullDescription": {
                "text": "Service-object soup scatters one workflow across many procedural steps and makes orchestration harder to change."
              }
            },
