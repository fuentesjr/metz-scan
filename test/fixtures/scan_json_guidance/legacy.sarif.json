                "level": "warning"
              },
              "helpUri": "https://github.com/fuentesjr/metz-scan#rule-MetzProject/RepeatedBranching",
              "help": {
                "text": "Repeated branching spreads one domain decision across files and makes change ripple outward."
              },
              "fullDescription": {
                "text": "Repeated branching spreads one domain decision across files and makes change ripple outward."
              }
            },
