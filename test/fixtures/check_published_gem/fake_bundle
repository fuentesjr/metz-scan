#!/usr/bin/env bash
set -euo pipefail

credential="${BUNDLE_RUBYGEMS__PKG__GITHUB__COM:-}"
if [ -n "$credential" ]; then
  export BUNDLE_RUBYGEMS__PKG__GITHUB__COM="$credential"
fi
FAKE_BUNDLE_LOG="${FAKE_BUNDLE_LOG:-$(cd "$(dirname "$0")" && pwd)/bundle.log}"
export FAKE_BUNDLE_LOG

ruby --disable-gems - "$@" <<'RUBY'
FORBIDDEN_RUNTIME_ENV = %w[
  BUNDLE_GEMFILE
  BUNDLE_BIN_PATH
  BUNDLER_VERSION
  GEM_HOME
  GEM_PATH
  RUBYLIB
  RUBYOPT
  BUNDLE_RUBYGEMS__PKG__GITHUB__COM
  GITHUB_PACKAGES_TOKEN
  GEM_CREDENTIALS
].freeze

EXPECTED_RUNTIME_ENV = {
  "BUNDLE_APP_CONFIG" => File.join(Dir.pwd, ".bundle"),
  "BUNDLE_PATH" => File.join(Dir.pwd, "vendor/bundle")
}.freeze

def log(message)
  File.open(ENV.fetch("FAKE_BUNDLE_LOG"), "a") { |file| file.puts(message) }
end

def version
  File.read("Gemfile").match(/gem "metz-scan", "([^"]+)"/)[1]
end

def normalized_path(path)
  File.expand_path(path).sub(%r{\A/private/var/}, "/var/")
end

def assert_runtime_env!
  leaked = FORBIDDEN_RUNTIME_ENV.find do |name|
    ENV.key?(name)
  end

  abort "runtime environment leaked: #{leaked}" if leaked

  EXPECTED_RUNTIME_ENV.each do |name, value|
    next if ENV[name] && normalized_path(ENV[name]) == normalized_path(value)

    abort "runtime environment mismatch: #{name}=#{ENV[name].inspect}"
  end
end

log("argv=#{ARGV.join(" ")}")
log("pwd=#{Dir.pwd}")

case ARGV
in ["install", *]
  log("install_pwd=#{Dir.pwd}")
  log("gem_line=#{File.read("Gemfile").lines.grep(/gem "metz-scan"/).first.strip}")
  puts ENV.fetch("BUNDLE_RUBYGEMS__PKG__GITHUB__COM")
  warn ENV.fetch("BUNDLE_RUBYGEMS__PKG__GITHUB__COM")
in ["exec", "metz-scan", "--version"]
  assert_runtime_env!
  puts version
in ["exec", "ruby", "-e", String]
  assert_runtime_env!
  puts version
  puts version
in ["exec", "metz-scan", "rules"]
  assert_runtime_env!
in ["exec", "metz-scan", "project-analyzers"]
  assert_runtime_env!
in ["exec", "metz-scan", "scan", "app", "--format", "text"]
  assert_runtime_env!
  puts "MetzProject/ServiceSoup"
  puts "Metz/ControllersTooManyDirectCollaborators"
  exit 1
else
  abort "unexpected fake bundle argv: #{ARGV.inspect}"
end
RUBY
