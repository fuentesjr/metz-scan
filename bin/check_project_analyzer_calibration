#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "json"
require "optparse"

require "metz_scan/calibration/project_analyzer_evidence_runner"

RUNNER = MetzScan::Calibration::ProjectAnalyzerEvidenceRunner
BASELINE_FILE = MetzScan::Calibration::ProjectAnalyzerEvidenceRunner::BaselineFile
USAGE = "Usage: check_project_analyzer_calibration [--json] [--text] [--default-output] " \
        "[--targets-file FILE] [--baseline-file FILE] [--output-dir DIR] [--run-id ID] " \
        "[--analyzer COP_NAME] [--print-baseline] [--baseline-label LABEL] [--no-write] [PATH ...]"

def parse_options
  default_options.tap { |options| option_parser(options).parse! }
end

def default_options
  { json: true, default_output: false, write: true, output_dir: RUNNER.default_results_path, run_id: nil,
    analyzer_names: [], targets_file: nil, baseline_file: nil, print_baseline: false, baseline_label: nil }
end

def option_parser(options)
  OptionParser.new do |parser|
    parser.banner = USAGE
    add_output_options(parser, options)
    add_artifact_options(parser, options)
  end
end

def add_output_options(parser, options)
  parser.on("--json", "Output JSON (default)") { options[:json] = true }
  parser.on("--text", "Output a compact text summary") { options[:json] = false }
  add_default_output_option(parser, options)
  add_analyzer_filter_option(parser, options)
end

def add_default_output_option(parser, options)
  parser.on("--default-output", "Restrict to analyzers with default-output eligibility") do
    options[:default_output] = true
  end
end

def add_analyzer_filter_option(parser, options)
  parser.on("--analyzer COP_NAME", "Restrict calibration to a project analyzer rule id") do |name|
    options.fetch(:analyzer_names) << name
  end
end

def add_artifact_options(parser, options)
  parser.on("--output-dir DIR", "Write artifacts under DIR") { |dir| options[:output_dir] = dir }
  add_targets_file_option(parser, options)
  add_baseline_options(parser, options)
  add_run_id_option(parser, options)
  add_write_options(parser, options)
end

def add_baseline_options(parser, options)
  add_baseline_file_option(parser, options)
  add_print_baseline_option(parser, options)
end

def add_run_id_option(parser, options)
  parser.on("--run-id ID", "Use ID as the artifact subdirectory name") { |id| options[:run_id] = id }
end

def add_write_options(parser, options)
  parser.on("--no-write", "Do not write calibration artifacts") { options[:write] = false }
  parser.on("-h", "--help", "Show usage") { exit_with_help(parser) }
end

def add_targets_file_option(parser, options)
  parser.on("--targets-file FILE", "Read calibration targets and scan paths from FILE") do |file|
    options[:targets_file] = file
  end
end

def add_baseline_file_option(parser, options)
  parser.on("--baseline-file FILE", "Compare counts with FILE; run scope must match") do |file|
    options[:baseline_file] = file
  end
end

def add_print_baseline_option(parser, options)
  parser.on("--print-baseline", "Print a compact baseline document and do not write artifacts") do
    options[:print_baseline] = true
    options[:write] = false
  end
  add_baseline_label_option(parser, options)
end

def add_baseline_label_option(parser, options)
  parser.on("--baseline-label LABEL", "Use LABEL in --print-baseline output") do |label|
    options[:baseline_label] = label
  end
end

def exit_with_help(parser)
  puts parser
  exit 0
end

def render_text(summary)
  text_lines(summary).join("\n")
end

def text_lines(summary)
  [target_line(summary), targets_file_line(summary), analyzer_filter_line(summary), finding_line(summary),
   *baseline_delta_lines(summary), *rule_section(summary), *readiness_lines(summary), *notable_finding_lines(summary),
   *breakdown_lines(summary), artifact_line(summary)].compact
end

def target_line(summary)
  "targets: #{summary.fetch('targets').map { |target| target.fetch('name') }.join(', ')}"
end

def finding_line(summary)
  "findings: #{summary.fetch('finding_count')} (offenses: #{summary.fetch('offense_count')})"
end

def analyzer_filter_line(summary)
  analyzer_names = summary.fetch("analyzer_filter", [])
  "analyzers: #{analyzer_names.join(', ')}" unless analyzer_names.empty?
end

def targets_file_line(summary)
  targets_file = summary["targets_file"]
  "targets file: #{targets_file}" if targets_file
end

def rule_lines(summary)
  summary.fetch("project_analyzers", {}).fetch("rules", []).map { |rule| rule_line(rule) }
end

def rule_section(summary)
  lines = rule_lines(summary)
  lines.empty? ? ["rules: none"] : ["rules:", *lines]
end

def rule_line(rule)
  "  - #{rule.fetch('cop_name')}: #{rule.fetch('finding_count')} finding(s), " \
    "#{rule.fetch('offense_count')} offense(s), status=#{rule.fetch('status', '?')}, " \
    "confidence=#{rule.fetch('confidence', '?')}, severity=#{rule.fetch('triage_severity', '?')}"
end

def readiness_lines(summary)
  readiness = summary.fetch("project_analyzers", {}).fetch("readiness", [])
  return [] if readiness.empty?

  ["readiness:", *readiness.map { |entry| readiness_line(entry) }]
end

def baseline_delta_lines(summary)
  delta = summary["baseline_delta"]
  return [] unless delta

  baseline_delta_header_lines(delta) + baseline_delta_detail_lines(delta)
end

def baseline_delta_header_lines(delta)
  ["baseline deltas: #{baseline_delta_label(delta)}",
   "  - findings: #{count_delta_label(delta.fetch('finding_count'))}",
   "  - offenses: #{count_delta_label(delta.fetch('offense_count'))}"]
end

def baseline_delta_detail_lines(delta)
  [baseline_rule_delta_line(delta),
   baseline_breakdown_delta_line("confidence", delta.dig("breakdowns", "confidence")),
   baseline_breakdown_delta_line("severity", delta.dig("breakdowns", "triage_severity")),
   baseline_breakdown_delta_line("category", delta.dig("breakdowns", "metadata", "project_analyzer_category"))]
end

def baseline_delta_label(delta)
  baseline = delta.fetch("baseline")
  [baseline["label"], baseline["file"]].compact.join(" ")
end

def baseline_rule_delta_line(delta)
  changed = delta.fetch("rules", []).select do |rule|
    changed_count?(rule.fetch("finding_count")) || changed_count?(rule.fetch("offense_count"))
  end
  return "  - analyzers: none" if changed.empty?

  "  - analyzers: #{changed.map { |rule| rule_delta_label(rule) }.join(', ')}"
end

def rule_delta_label(rule)
  "#{rule.fetch('cop_name')} findings=#{signed_delta(rule.fetch('finding_count'))} " \
    "offenses=#{signed_delta(rule.fetch('offense_count'))}"
end

def baseline_breakdown_delta_line(label, entries)
  changed = Array(entries).select { |entry| changed_count?(entry.fetch("finding_count")) }
  return "  - #{label}: none" if changed.empty?

  "  - #{label}: #{breakdown_delta_labels(changed).join(', ')}"
end

def breakdown_delta_labels(entries)
  entries.map { |entry| "#{entry.fetch('value')}=#{signed_delta(entry.fetch('finding_count'))}" }
end

def count_delta_label(count)
  "#{signed_delta(count)} (baseline=#{count.fetch('baseline')}, current=#{count.fetch('current')})"
end

def signed_delta(count)
  delta = count.fetch("delta")
  delta.positive? ? "+#{delta}" : delta.to_s
end

def changed_count?(count)
  count.fetch("delta").nonzero?
end

def readiness_line(entry)
  "  - #{entry.fetch('rule_id')}: #{entry.fetch('disposition')} evidence=#{entry.fetch('evidence')} " \
    "next=#{entry.fetch('next')} not_next=#{entry.fetch('not_next')}"
end

def notable_finding_lines(summary)
  notable_findings = summary.fetch("notable_findings", [])
  return [] if notable_findings.empty?

  ["notable findings:", *notable_findings.map { |finding| notable_finding_line(finding) }]
end

def notable_finding_line(finding)
  location = notable_finding_location(finding)
  category = finding["category"] ? ", category=#{finding['category']}" : ""
  "  - #{finding.fetch('target')}: #{finding.fetch('rule_id')}, confidence=#{finding.fetch('confidence', '?')}, " \
    "severity=#{finding.fetch('triage_severity', '?')}#{category}, location=#{location}, " \
    "message=#{finding.fetch('message')}"
end

def notable_finding_location(finding)
  occurrence = finding.fetch("occurrence", {})
  [occurrence["path"], occurrence["line"]].compact.join(":")
end

def breakdown_lines(summary)
  breakdowns = summary.fetch("breakdowns", {})
  return [] if breakdowns.empty?

  ["breakdowns:", *basic_breakdown_lines(breakdowns), *metadata_breakdown_lines(breakdowns.fetch("metadata", {}))]
end

def basic_breakdown_lines(breakdowns)
  [["confidence", breakdowns["confidence"]], ["severity", breakdowns["triage_severity"]]]
    .filter_map { |label, values| breakdown_line(label, values) }
end

def metadata_breakdown_lines(metadata)
  metadata.filter_map { |key, values| breakdown_line(key, values) }
end

def breakdown_line(label, values)
  return if values.to_a.empty?

  "  - #{label}: #{values.map { |value| "#{value.fetch('value')}=#{value.fetch('finding_count')}" }.join(', ')}"
end

def artifact_line(summary)
  artifacts = summary.fetch("artifacts", {})
  "artifacts: #{artifacts.fetch('directory')}" unless artifacts.empty?
end

def emit_json(summary)
  JSON.pretty_generate(summary)
end

def summary_for(options)
  RUNNER.summarize(paths: ARGV, default_output: options.fetch(:default_output),
                   analyzer_names: options.fetch(:analyzer_names), targets_file: options[:targets_file],
                   baseline_file: options[:baseline_file])
end

def write_artifacts(summary, options)
  RUNNER.write_artifacts(summary, output_dir: options.fetch(:output_dir), run_id: options[:run_id])
end

def emit_baseline(summary, options)
  baseline_for(summary, options).to_yaml
end

def baseline_for(summary, options)
  BASELINE_FILE.from_summary(summary, **baseline_options(options))
end

def baseline_options(options)
  { label: baseline_label(options),
    generated_from: generated_from(options),
    targets_file: options[:targets_file] }
end

def baseline_label(options)
  options[:baseline_label] || "calibration-baseline"
end

def generated_from(options)
  options[:targets_file] || "paths"
end

begin
  options = parse_options
  summary = summary_for(options)
  if options.fetch(:print_baseline)
    puts emit_baseline(summary, options)
    exit 0
  end
  summary = summary.merge("artifacts" => write_artifacts(summary, options)) if options.fetch(:write)
  puts(options.fetch(:json) ? emit_json(summary) : render_text(summary))
  exit 0
rescue OptionParser::ParseError, MetzScan::Calibration::ProjectAnalyzerEvidenceRunner::Error => e
  warn "check_project_analyzer_calibration: #{e.message}"
  exit 1
rescue StandardError => e
  warn "check_project_analyzer_calibration: #{e.message}"
  exit 2
end
