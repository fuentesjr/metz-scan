#!/usr/bin/env ruby
# frozen_string_literal: true

# Reproduces the CI environment before pushing: clones the committed HEAD into
# a temp dir and runs the single-command CI steps from .github/workflows/ci.yml
# there. The clone drops untracked files and local bundler config (including
# the optional rubydex group CI never installs), so environment assumptions
# that pass in this checkout but would fail in CI fail here first. The
# multi-line GitHub annotations smoke is not replicated; it stays covered by
# CI and RELEASE_CHECKLIST.md. Uncommitted changes are not checked — commit
# the slice, run this, then push.

require "fileutils"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)
CALIBRATION_SMOKE = "bundle exec ruby bin/check_project_analyzer_calibration --text --no-write " \
                    "test/fixtures/sample_app"

# Scrub the invoking checkout's bundler state so the clone resolves its own.
CLEAN_BUNDLER_ENV = {
  "BUNDLE_IGNORE_CONFIG" => "1",
  "BUNDLE_GEMFILE" => nil,
  "BUNDLE_BIN_PATH" => nil,
  "BUNDLER_VERSION" => nil,
  "RUBYOPT" => nil,
  "RUBYLIB" => nil
}.freeze

STEPS = [
  ["tracker hygiene", "bin/check_tracker_queue"],
  ["bundle install", "bundle install"],
  ["tests", "bundle exec rake"],
  ["rubocop", "bundle exec rubocop"],
  ["calibration smoke", CALIBRATION_SMOKE],
  ["read-only command guard", "bin/check_read_only_commands"],
  ["dependency direction", "bin/check_dependency_direction"],
  ["sample app frozen", "bin/check_sample_app_frozen"]
].freeze

def run_step(step, dir)
  phase, command = step
  started_at = monotonic_time
  puts "check_ci_parity: phase=#{phase} command=#{command}"
  return phase_ok(phase, started_at) if system(CLEAN_BUNDLER_ENV, command, chdir: dir)

  fail_phase(phase, command, dir, started_at)
end

def phase_ok(phase, started_at)
  puts "check_ci_parity: phase=#{phase} ok (#{elapsed_time(started_at)})"
end

def fail_phase(phase, command, dir, started_at)
  warn "check_ci_parity: failed phase=#{phase} command=#{command} after #{elapsed_time(started_at)}"
  warn "check_ci_parity: clean clone preserved at #{dir}"
  warn "check_ci_parity: next action: cd #{dir} && #{command}"
  exit 1
end

def monotonic_time
  Process.clock_gettime(Process::CLOCK_MONOTONIC)
end

def elapsed_time(started_at)
  format("%.1fs", monotonic_time - started_at)
end

def parity_tmpdir
  Dir.mktmpdir("metz-scan-ci-parity-", ENV.fetch("CI_PARITY_TMPDIR", nil))
end

puts "check_ci_parity: ruby #{RUBY_VERSION} (CI pins its version in .github/workflows/ci.yml)"

tmp = parity_tmpdir
success = false
clone = File.join(tmp, "metz-scan")

begin
  unless system("git", "clone", "--quiet", "--local", ROOT, clone)
    warn "check_ci_parity: failed to clone #{ROOT}"
    warn "check_ci_parity: temp dir preserved at #{tmp}"
    exit 1
  end

  STEPS.each { |step| run_step(step, clone) }
  success = true
ensure
  FileUtils.remove_entry(tmp) if success && File.exist?(tmp)
end

puts "check_ci_parity: ok"
