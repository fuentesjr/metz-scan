#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"

FAIL_CLOSED = "fail: banned list not found in base unslop skill"
PLAYBOOK_CLOSED = "fail: playbook copy not found in base"
UNSLOP_LINE = "Run /unslop on the PR title and body, then edit the PR."
EDIT_LINE = "Edit the PR title and body to follow .cursor/rules/opening-a-pr.mdc."
DEPENDABOT_LOGIN = "dependabot[bot]"
SKILL_NAME = "unslop-SKILL.md"
COPY_NAME = "opening-a-pr.mdc"
FORMAT = "type(scope): subject"
TITLES_MARK = "**Titles.**"
TITLE_FORMAT = /\A[a-z]+\([^ ()]+\): (?<subject>.+)\z/
TOKEN = /`([^`]+)`/
SECTION_RULE = /\A- `(## [^`]+)`:/
HEADING = /\A {0,3}(\#{1,6})([ \t]|\z)/
TOKEN_LIMIT = 40
SUFFIXES = ["", "s", "es", "d", "ed", "ing"].freeze
DASH_CHARS = [["\u2014", "U+2014"], ["\u2013", "U+2013"]].freeze
ENTITY = /&(?:mdash|ndash);|&#0*8212;|&#0*8211;|&#x0*2014;|&#x0*2013;/i
OWNER_REPO = %r{(?<![A-Za-z0-9-])[A-Za-z0-9-]+/[A-Za-z0-9._-]+#\d+}
PULL_OR_ISSUE = /
  \b(?i:PR)[ \t]*\#[ \t]*\d+ |
  \b(?i:PR)[ \t]+\d+ |
  \b(?i:pull\ request)[ \t]+\#?[ \t]*\d+ |
  \b(?i:issue)[ \t]*\#[ \t]*\d+ |
  \b(?i:issue)[ \t]+\d+
/x
LETTER_LABEL = /\b(?i:PR)[ \t]+(?!(?i:I)\b)[A-Z]\b/
BARE_NUMBER = /#\d+/
REFERENCE_PATTERNS = [OWNER_REPO, PULL_OR_ISSUE, LETTER_LABEL, BARE_NUMBER].freeze
LINK_TEXT = /\[([^\[\]]*)\]\([^)]*\)/
RULE_SEVEN = /\*\*AI vocabulary\.\*\*\s+(.+?)\.\s+Replace with plain words/
REFERENCE_CHARS = %r{[^A-Za-z0-9#/._ -]}

def main
  return pass("pass: dependabot") if dependabot?
  return playbook_closed unless (book = rulebook)
  return fail_closed if (words = banned_words).empty?

  report_body(book, words)
end

def report_body(book, words)
  lines = body_lines
  sections = section_findings(book, lines)
  report(sections, scan_title(pull_request("title"), words) + scan_lines(lines, words))
end

def body_lines
  pull_request("body").gsub(/\r\n?/, "\n").split("\n")
end

def report(sections, unslop)
  return pass("pass") if sections.empty? && unslop.empty?

  (sections + unslop).each { |line| puts line }
  puts EDIT_LINE unless sections.empty?
  puts UNSLOP_LINE unless unslop.empty?
  1
end

def playbook_closed
  puts PLAYBOOK_CLOSED
  1
end

def pass(line)
  puts line
  0
end

def fail_closed
  puts FAIL_CLOSED
  1
end

def dependabot?
  event.dig("pull_request", "user", "login") == DEPENDABOT_LOGIN
end

def pull_request(field)
  event.dig("pull_request", field).to_s
end

def event
  @event ||= JSON.parse(File.read(ENV.fetch("GITHUB_EVENT_PATH")))
end

def banned_words
  text = skill_text
  return [] unless text

  parse_rule_seven(text)
end

def skill_text
  root = runner_root
  read_cached(File.join(root, SKILL_NAME)) if root
end

def copy_text
  root = runner_root
  read_cached(File.join(root, COPY_NAME)) if root
end

def runner_root
  root = ENV.fetch("RUNNER_TEMP", nil)
  root unless root.nil? || root.empty?
end

def read_cached(path)
  return unless File.file?(path)

  text = File.read(path)
  text unless text.empty?
end

def rulebook
  text = copy_text
  return unless text && format_token(text) == FORMAT

  sections = section_list(text)
  { sections: sections } unless sections.empty?
end

def format_token(text)
  line = text.each_line.find { |entry| entry.start_with?(TITLES_MARK) }
  return unless line

  line[TOKEN, 1]
end

def section_list(text)
  text.each_line.filter_map { |entry| section_rule(entry) }
end

def section_rule(entry)
  name = entry[SECTION_RULE, 1]
  return unless name

  { name: name, text: name.delete_prefix("## "), optional: entry.include?("Skip when") }
end

def section_findings(book, lines)
  found = scan_headings(lines)
  state = walked(found, book)
  title_finding + state.fetch(:level) + missing_for(book, state) + state.fetch(:order) +
    state.fetch(:unknown) + empty_for(lines, found, state)
end

def walked(found, book)
  state = { seen: {}, last: -1, level: [], order: [], unknown: [], present: [], first: [] }
  found.each { |heading| note_heading(heading, book, state) }
  state
end

def note_heading(heading, book, state)
  name = heading_name(heading, book)
  return note_other_level(name, state) unless heading.fetch(:level) == 2

  note_level_two(heading, name, book, state)
end

def note_other_level(name, state)
  state[:level] << "fail: wrong heading level #{name}" if name
end

def note_level_two(heading, name, book, state)
  return state[:unknown] << "fail: unknown section" if name.nil? || state[:seen][name]

  state[:seen][name] = true
  state[:present] << name
  state[:first] << heading.merge(name: name)
  note_order(name, section_rank(book, name), state)
end

def note_order(name, rank, state)
  return state[:order] << "fail: section out of order #{name}" if rank < state[:last]

  state[:last] = rank
end

def missing_for(book, state)
  book.fetch(:sections).filter_map { |section| missing_finding(section, state.fetch(:present)) }
end

def title_finding
  return [] unless bad_title?(pull_request("title"))

  ["fail: bad title"]
end

def bad_title?(title)
  match = TITLE_FORMAT.match(title.sub(/[ \t]+\z/, ""))
  return true unless match

  match[:subject].end_with?(".")
end

def scan_headings(lines)
  lines.each_with_index.filter_map { |line, index| heading_from(line, index) }
end

def heading_from(line, index)
  match = HEADING.match(line)
  return unless match

  { level: match[1].length, text: heading_text(line, match.end(0)), line: index }
end

def heading_text(line, offset)
  line[offset..].sub(/[ \t]+\z/, "")
end

def missing_finding(section, present)
  return if section.fetch(:optional) || present.include?(section.fetch(:name))

  "fail: missing section #{section.fetch(:name)}"
end

def empty_for(lines, found, state)
  state.fetch(:first).filter_map { |heading| empty_line(heading, lines, found) }
end

def empty_line(heading, lines, found)
  return unless blank_span?(lines, heading, found)

  "fail: empty section #{heading.fetch(:name)}"
end

def blank_span?(lines, heading, found)
  stop = next_heading_line(found, heading) || lines.size
  lines[(heading.fetch(:line) + 1)...stop].all? { |line| line.match?(/\A[ \t]*\z/) }
end

def next_heading_line(found, heading)
  nxt = found.find { |item| item.fetch(:line) > heading.fetch(:line) }
  nxt&.fetch(:line)
end

def heading_name(heading, book)
  section = named_section(book, heading.fetch(:text))
  section&.fetch(:name)
end

def named_section(book, text)
  book.fetch(:sections).find { |section| section.fetch(:text) == text }
end

def section_rank(book, name)
  book.fetch(:sections).index { |section| section.fetch(:name) == name }
end

def parse_rule_seven(text)
  line = text.each_line.find { |entry| entry.include?("**AI vocabulary.**") }
  list = line && line[RULE_SEVEN, 1]
  return [] unless list

  list.split(",").filter_map { |part| rule_word(part) }
end

def rule_word(part)
  word = part.strip
  return if word.empty? || word.include?("(abstract)")

  word
end

def scan_title(text, words)
  scan_line(text, "title", words, false)
end

def scan_lines(lines, words)
  lines.each_with_index.flat_map do |line, index|
    scan_line(line, "body line #{index + 1}", words, true)
  end
end

def scan_line(line, where, words, exempt_links)
  hits = dash_hits(line) + reference_hits(line, exempt_links) + word_hits(line, words)
  hits.sort_by { |hit| hit[:pos] }.map { |hit| format_hit(hit, where) }
end

def dash_hits(line)
  chars = DASH_CHARS.flat_map { |char, name| literal_hits(line, char, name) }
  entities = scan_spans(line, ENTITY).map { |span| span_hit(span, "dash", span[:text]) }
  spaces = scan_spans(line, / -- /).map { |span| span_hit(span, "dash", "--") }
  chars + entities + spaces
end

def literal_hits(line, token, name)
  scan_spans(line, Regexp.new(Regexp.escape(token))).map { |span| span_hit(span, "dash", name) }
end

def reference_hits(line, exempt_links)
  ranges = exempt_links ? link_ranges(line) : []
  reference_matches(line).filter_map { |span| reference_hit(span, ranges) }
end

def reference_hit(span, ranges)
  return if covered?(span, ranges)

  span_hit(span, "unlinked reference", clean_reference(span[:text]))
end

def word_hits(line, words)
  words.flat_map { |word| surface_hits(line, word) }
end

def surface_hits(line, word)
  surfaces(word).flat_map do |surface|
    pattern = /\b#{Regexp.escape(surface)}\b/i
    scan_spans(line, pattern).map { |span| span_hit(span, "banned word", word) }
  end
end

def surfaces(word)
  forms = SUFFIXES.map { |suffix| "#{word}#{suffix}" }
  forms << "#{word.delete_suffix('e')}ing" if word.end_with?("e")
  forms.uniq
end

def reference_matches(line)
  spans = keep_spans(REFERENCE_PATTERNS.flat_map { |pattern| scan_spans(line, pattern) })
  entities = scan_spans(line, ENTITY)
  spans.reject { |span| inside_entity?(span, entities) }
end

def inside_entity?(span, entities)
  entities.any? { |entity| entity[:start] <= span[:start] && span[:end] <= entity[:end] }
end

def keep_spans(spans)
  chosen = []
  walk_spans(spans.sort_by { |span| [span[:start], -span[:text].length] }, chosen)
  chosen
end

def walk_spans(spans, chosen)
  cursor = 0
  spans.each { |span| cursor = take_span(span, cursor, chosen) }
end

def take_span(span, cursor, chosen)
  return cursor if span[:start] < cursor

  chosen << span
  span[:end]
end

def link_ranges(line)
  ranges_for(line, LINK_TEXT) { |match| text_range(match) }
end

def ranges_for(line, pattern)
  ranges = []
  each_match(line, pattern) { |match| ranges << yield(match) }
  ranges
end

def each_match(line, pattern)
  offset = 0
  while (match = pattern.match(line, offset))
    yield match
    offset = match.end(0)
  end
end

def text_range(match)
  start = match.begin(0) + 1
  start...(start + match[1].length)
end

def covered?(span, ranges)
  ranges.any? { |range| range.cover?(span[:start]) && range.cover?(span[:end] - 1) }
end

def clean_reference(text)
  text.gsub(REFERENCE_CHARS, "")[0, TOKEN_LIMIT]
end

def scan_spans(line, pattern)
  spans = []
  line.scan(pattern) { spans << span_from(Regexp.last_match) }
  spans
end

def span_from(match)
  { start: match.begin(0), end: match.end(0), text: match[0].dup }
end

def span_hit(span, rule, token)
  { pos: span[:start], rule: rule, token: token }
end

def format_hit(item, where)
  "fail: #{item[:rule]} #{item[:token]} at #{where}"
end

exit main
