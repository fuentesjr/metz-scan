#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "optparse"

DEFAULT_COMMANDS = [
  "bundle exec ruby bin/check_project_analyzer_calibration --text --no-write test/fixtures/sample_app",
  "bundle exec ruby bin/check_project_analyzer_calibration --print-baseline --baseline-label " \
  "sample-app-preview --analyzer MetzProject/RepeatedBranching test/fixtures/sample_app",
  "bin/check_rubydex_drift --allow-missing-rubydex --text test/fixtures/sample_app",
  "bin/render_issue_comment_summary 27"
].freeze

CLEAN_BUNDLER_ENV = {
  "BUNDLE_FROZEN" => "1"
}.freeze

def parse_options
  options = { commands: [], list_default_commands: false }
  OptionParser.new { |parser| configure_options(parser, options) }.parse!
  options
end

def configure_options(parser, options)
  parser.banner = "Usage: check_read_only_commands [--command COMMAND ...] [--list-default-commands]"
  add_command_option(parser, options.fetch(:commands))
  add_list_default_commands_option(parser, options)
  add_help_option(parser)
end

def add_command_option(parser, commands)
  parser.on("--command COMMAND", "Run COMMAND and assert it leaves tracked files unchanged") do |command|
    commands << command
  end
end

def add_list_default_commands_option(parser, options)
  parser.on("--list-default-commands", "Print the default guarded commands and exit") do
    options[:list_default_commands] = true
  end
end

def add_help_option(parser)
  parser.on("-h", "--help", "Show usage") do
    puts parser
    exit 0
  end
end

def git_root
  stdout, stderr, status = Open3.capture3("git", "rev-parse", "--show-toplevel")
  abort "check_read_only_commands: #{stderr.strip}" unless status.success?

  stdout.strip
end

def tracked_status(root)
  stdout, stderr, status = Open3.capture3("git", "status", "--porcelain", "--untracked-files=no", chdir: root)
  abort "check_read_only_commands: #{stderr.strip}" unless status.success?

  stdout
end

def selected_commands(options)
  commands = options.fetch(:commands)
  commands.empty? ? DEFAULT_COMMANDS : commands
end

def list_default_commands
  puts DEFAULT_COMMANDS
  exit 0
end

def ensure_clean_start!(root)
  status = tracked_status(root)
  return if status.empty?

  warn "check_read_only_commands: tracked files are already dirty"
  warn status
  exit 1
end

def run_command(command, root)
  puts "check_read_only_commands: #{command}"
  return if system(CLEAN_BUNDLER_ENV, command, chdir: root)

  warn "check_read_only_commands: failed: #{command}"
  exit 1
end

def ensure_unchanged!(root, command)
  status = tracked_status(root)
  return if status.empty?

  warn "check_read_only_commands: changed tracked files after: #{command}"
  warn status
  exit 1
end

options = parse_options
list_default_commands if options.fetch(:list_default_commands)
commands = selected_commands(options)
root = git_root
ensure_clean_start!(root)
commands.each do |command|
  run_command(command, root)
  ensure_unchanged!(root, command)
end
puts "check_read_only_commands: ok"
